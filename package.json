{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev --host",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"start": "bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "bun test tests/unit",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@iconify-json/fluent": "^1.2.58",
		"@iconify-json/fluent-emoji": "1.2.7",
		"@iconify-json/heroicons": "1.2.3",
		"@iconify-json/material-symbols": "^1.2.93",
		"@inlang/paraglide-js": "^2.25.4",
		"@inlang/plugin-m-function-matcher": "^2.2.16",
		"@inlang/plugin-message-format": "^4.4.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "^1.4.2",
		"@types/leaflet": "1.9.22",
		"@types/node": "^26.6.2",
		"@typescript/native": "npm:typescript@7",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vite-pwa/sveltekit": "1.1.0",
		"daisyui": "5.7.45",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"leaflet": "1.9.4",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "4.7.6",
		"svelte-cookie-consent": "^2.3.1",
		"tailwindcss": "4.3.3",
		"typescript": "~6",
		"typescript-eslint": "8.70.1",
		"unplugin-icons": "24.0.0",
		"vite": "8.3.1"
	},
	"dependencies": {
		"@boxfish-studio/sveltekit-cookie-manager": "1.0.3",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource/dm-serif-display": "^5.3.0",
		"@iconify/svelte": "5.2.2",
		"@tailwindcss/typography": "0.5.20",
		"html2canvas-pro": "^2.4.5",
		"jsdom": "30.1.1",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"sveaflet": "^0.1.5",
		"sveltekit-superforms": "2.30.2",
		"valibot": "1.5.0"
	}
}
